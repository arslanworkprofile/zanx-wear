# ==========================================
# ZANX WEAR — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ==========================================

# MongoDB Atlas
# Create a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/zanxwear?retryWrites=true&w=majority

# NextAuth / Auth.js
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Google sign-in has been removed from this project — email/password login only.
# (If you want it back later, this is where the client ID/secret would go.)

# JWT (used for custom API/admin tokens in addition to NextAuth's session JWT)
JWT_SECRET=replace-with-another-long-random-string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used only by scripts/seed.ts to create the first admin user)
ADMIN_EMAIL=admin@zanxwear.com
ADMIN_PASSWORD=aass1234

# Payment gateways — leave blank until you're ready to enable a provider.
# The checkout module (lib/payments) is written against this interface so any
# of these can be dropped in without touching page code.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

EASYPAISA_STORE_ID=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_HASH_KEY=

# App
NEXT_PUBLIC_SITE_NAME=ZANX WEAR
NEXT_PUBLIC_SITE_URL=http://localhost:3000
